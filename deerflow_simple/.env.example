# 模型配置（OpenAI 兼容，可填 DeepSeek / OpenAI / 本地 vLLM）
DS_MODEL=gpt-4o-mini
DS_BASE_URL=
DS_API_KEY=

# 也可以直接用 OpenAI 的标准环境变量
OPENAI_API_KEY=
OPENAI_BASE_URL=

# LangSmith 追踪（可选）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deerflow-simple

# Checkpointer（对话状态持久化，可选）
# memory = 进程内（默认，重启即丢）；sqlite = 本地文件持久化
# 通过 SimpleConfig(checkpointer_type="sqlite", checkpointer_path=".deerflow_simple/checkpoints.db") 配置
# sqlite 后端需额外安装：pip install langgraph-checkpoint-sqlite
