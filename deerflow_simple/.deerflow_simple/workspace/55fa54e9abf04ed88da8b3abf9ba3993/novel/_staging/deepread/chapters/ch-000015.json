      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-32",
      "text": "玄奘回说法明：\"其实我觉得还是像以前在执事堂好，有时间可以养养花，看看天，我背不来那些佛经。\"",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0053/index.json",
        "record_id": "char-0053"
      },
      "revealed_at": 15,
      "source_refs": [
