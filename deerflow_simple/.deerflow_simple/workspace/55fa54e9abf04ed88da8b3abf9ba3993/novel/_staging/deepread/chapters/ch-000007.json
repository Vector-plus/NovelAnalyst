  "appended_updates_to_existing_events": [],
  "new_claims": [
    {
      "local_id": "claim-local-1",
      "text": "当第一天月亮开始升上天空的时候，天蓬就已经在旁看着女子收取天地间无数微尘、挑出银色颗粒。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "当第一天月亮开始升上天空的时候"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-2",
      "text": "她做事时不准天蓬说话（怕吹走沙粒），天蓬便不说话；星际旅者呼啸而过时，天蓬举起宽大翅膀替她遮挡风和杂尘。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "她做事时不准天蓬说话"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-3",
      "text": "她挑选银尘做了八十万年，天蓬在旁守候八十万年，其间两人未说一句话，最终共选出十亿亿万粒银尘。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "她一直做了八十万年"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-4",
      "text": "天蓬此前独自在没有光的天河里孤独地生活。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "一个人在没有光的天河里孤独地生活"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-5",
      "text": "她第一次扬起手，十亿亿万银尘全部飞扬上天际，万古黑暗的天穹中出现了无数银色微尘闪耀。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "她第一次扬起手"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-6",
      "text": "她用手轻遮天蓬的嘴，说「别，别吓着她们」，眼中流露无限爱意。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0016/index.json",
        "record_id": "char-0016"
      },
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "别，别吓着她们"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-7",
      "text": "她第二次扬起手，漫天银尘旋转，绕着二人所在之处越转越快，形成无比巨大的银色光环；天蓬脚步踉跄，微微靠在她身上，她并未推开他。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "她第二次扬起手"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-8",
      "text": "她用手轻轻挽住天蓬，轻声说「小心」。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0016/index.json",
        "record_id": "char-0016"
      },
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "她仍然是那么轻声地说"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-9",
      "text": "她第三次扬起手，光环向中心汇聚，形成亿万条向核心流动的银线，光环中心一个小银核越来越清晰。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "她第三次扬起手"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-10",
      "text": "天蓬问是什么在吸引银尘，她先答「是我」，随后改口「是我们」并笑了，用手指点了一下天蓬。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0016/index.json",
        "record_id": "char-0016"
      },
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "是什么在吸引它们？"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-11",
      "text": "天蓬将她揽入怀中，二人深吻。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "将她揽入怀中"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-12",
      "text": "长吻结束后，她被吻时法力消散，银核已经汇聚，但仍有几亿颗银尘散落在天河各处。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "她被吻时法力消散"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-13",
      "text": "她掩面哭泣。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "她掩面哭泣了起来"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-14",
      "text": "她自陈做了那么久、花了那么长时间，还是失败了。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0016/index.json",
        "record_id": "char-0016"
      },
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "还是失败了"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-15",
      "text": "天蓬揽住她的肩，对她说别哭了，世间没有一件造物会是完美的，有时缺憾会更美，并让她抬头看。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0015/index.json",
        "record_id": "char-0015"
      },
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "世间没有一件造物会是完美的"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-16",
      "text": "她抬起头，看见天河四野俱是银星闪耀。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "俱是银星闪耀"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-17",
      "text": "天蓬提出把原为黑暗、现为银色的天河改叫「银河」，并让女子为那个银色小球起名。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0015/index.json",
        "record_id": "char-0015"
      },
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "我们就改叫它"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-18",
      "text": "女子说用她的名字为银核命名，叫它「月」。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0016/index.json",
        "record_id": "char-0016"
      },
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "用我的名字吧，叫它——月"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-19",
      "text": "天蓬问自己是否可以说「月光下，映着一对爱人」。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0015/index.json",
        "record_id": "char-0015"
      },
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "映着一对爱人吗"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-20",
      "text": "结尾时，两人在月光下紧紧相拥。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 7,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000007.txt",
          "chapter_id": "ch-000007",
          "chapter_order": 7,
          "locator": null,
          "anchor": "他们紧紧相拥"
        }
      ],
      "basis_refs": [],
