      },
      "revealed_at": 50,
      "source_refs": [
        {
          "path": "source/vol-002/ch-000050.txt",
          "chapter_id": "ch-000050",
          "chapter_order": 50,
          "locator": null,
          "anchor": "我会每天去旅行，然后把我看见的回来告诉你"
