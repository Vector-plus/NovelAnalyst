      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-15",
      "text": "紫霞继续说：孙悟空不能成正果，永远不要想和她在一起；并说花果山的天空其实是一片黑暗，在那里看不见晚霞。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0023/index.json",
