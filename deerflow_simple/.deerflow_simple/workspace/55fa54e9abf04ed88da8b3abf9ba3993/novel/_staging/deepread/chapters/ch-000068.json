  "new_claims": [
    {
      "local_id": "claim-local-1",
      "text": "孙悟空与大鹏王激战正酣时，背后有人唤他名字。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "孙悟空与大鹏斗得正欢"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-2",
      "text": "孙悟空一回头，满天云雾疾扑而来，仿佛时光千万里离他而去、身在九天之外，云雾散开后面前出现一尊巨佛。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "面前出现一尊巨佛"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-3",
      "text": "巨佛的宏大而平缓的声音说：“孙悟空，你说跳出我掌心，便把天宫让你，现在你跳来跳去，跳出去了么？”又说“若跳不出时，你便老实下界，再修几劫，却来争吵”。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "巨佛/心中的声音"
      },
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "你说跳出我掌心，便把天宫让你"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-4",
      "text": "该声音问“你不想回花果山么”，一挥手云散，露出一片青翠群山（本章叙述此处称其为“如来”）。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "露出一片青翠群山"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-5",
      "text": "孙悟空望着下方的花果山景象，忽然想起许多事，眼神迷离。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "忽然他想起了许多事，眼神迷离了"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-6",
      "text": "声音说“我在你心中，在你本不去关注的深处”，并说孙悟空牵挂身体、执著于未来生存，所以感受不到本来的快乐，只关注存在的这一刻便看见生命的美丽。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "巨佛/心中的声音"
      },
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "我在你心中"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-7",
      "text": "声音说“所以你要学超脱之术”。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "巨佛/心中的声音"
      },
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "所以你要学超脱之术"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-8",
      "text": "孙悟空自述：他不想消失，想成为神是为了拥有，可他却只有放弃才能成为神。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0002/index.json",
        "record_id": "char-0002"
      },
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "我想成为神是为了拥有"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-9",
      "text": "声音问他：“你抗拒，除了毁灭你得到什么了吗？……你要重新制定价值，你得到了什么样的世界呢？”",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "巨佛/心中的声音"
      },
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "你抗拒，除了毁灭你得到什么了吗"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-10",
      "text": "一声尖利怪异的喊声划破天空，一只怪鸟掠过；孙悟空转头，四周已是一片黑暗的焦土、地狱景色，无数烧焦的黑色树躯上长着仇视的眼睛，眼睛变成铺天盖地的怪鸟飞上天空。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "四周忽然已是一片黑暗的焦土"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-11",
      "text": "怪鸟突然说话（仍是先前那个声音）：“你还能毁灭更多吗？”",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "巨佛/心中的声音"
      },
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "你还能毁灭更多吗"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-12",
      "text": "孙悟空连声喊“是我的错？是我的错我的错我的错”，随后沉默。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0002/index.json",
        "record_id": "char-0002"
      },
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "是我的错我的错我的错"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-13",
      "text": "怪鸟变成洁白羽翼的仙鹤，把一袋种子放到孙悟空手中。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "把一袋种子放到孙悟空手中"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-14",
      "text": "那声音说“这儿有种子，只有这种种子能在花果山的焦土上生长”，又说“现在你把它种下去吧”。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "巨佛/心中的声音"
      },
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "只有这种种子能在花果山的焦土上生长"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-15",
      "text": "孙悟空手颤抖着看那袋种子，泪流满面。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "这个硬汉居然泪流满面"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-16",
      "text": "一名女子的声音喊“不！”，并说“他在骗你，你在你的心障之中”，孙悟空随即直起身来。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "心障中的女子之声"
      },
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "你在你的心障之中"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-17",
      "text": "那声音有点慌地问：“你不相信么？”又说“你要放弃么，可以，就让花果山永远这样下去吧。”",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "巨佛/心中的声音"
      },
      "revealed_at": 68,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000068.txt",
          "chapter_id": "ch-000068",
          "chapter_order": 68,
          "locator": null,
          "anchor": "你要放弃么，可以，就让花果山永远这样下去吧"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-18",
      "text": "孙悟空闭眼深吸一口气后问“你是如来？”，那声音回答“不，我是你的心”。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "巨佛/心中的声音"
