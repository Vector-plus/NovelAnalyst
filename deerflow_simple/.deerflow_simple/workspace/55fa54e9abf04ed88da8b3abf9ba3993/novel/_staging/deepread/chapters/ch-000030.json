      "local_id": "ev-local-1",
      "title": "大战之后天宫审天蓬：定罪与判罚",
      "introduced_at": 30,
      "update": {
        "local_id": "update-local-1",
        "chapter_ranges": [
          {
            "start": 30,
            "end": 30
          }
