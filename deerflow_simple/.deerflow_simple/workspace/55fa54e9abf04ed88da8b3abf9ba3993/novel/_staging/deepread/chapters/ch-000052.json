      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-3",
      "text": "大鸟把躲在身后的小鸟推出来，向松鼠介绍他叫阿笨，是今年才生的，第一次回老家，怕生。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "大鸟"
      },
      "revealed_at": 52,
      "source_refs": [
