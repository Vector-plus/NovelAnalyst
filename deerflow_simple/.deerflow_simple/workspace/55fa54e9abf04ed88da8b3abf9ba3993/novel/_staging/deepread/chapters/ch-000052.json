      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-2",
      "text": "一只翅膀展开如云彩的大鸟对松鼠说“这是我们的家”，并说自己也没见过松鼠这个小家伙。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "大鸟"
      },
      "revealed_at": 52,
      "source_refs": [
        {
          "path": "source/vol-002/ch-000052.txt",
          "chapter_id": "ch-000052",
          "chapter_order": 52,
          "locator": null,
          "anchor": "这是我们的家啊"
