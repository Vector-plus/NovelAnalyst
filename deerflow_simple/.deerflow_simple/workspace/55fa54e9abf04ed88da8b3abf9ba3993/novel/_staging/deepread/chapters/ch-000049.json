      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "c-27",
      "text": "二郎神驾云出天庭奉命收拾战场，见云头下烧焦的花果山大地上，孙悟空扔下的金箍棒不见了。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0064/index.json",
        "record_id": "char-0064"
      },
      "revealed_at": 49,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000049.txt",
