      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "c-28",
      "text": "叙述以反问「怎么可能有人将它拿走？除了孙悟空还有谁搬得动它呢？」表达对金箍棒下落的疑问，本章未写明取走者是谁。",
      "certainty": "uncertain",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 49,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000049.txt",
