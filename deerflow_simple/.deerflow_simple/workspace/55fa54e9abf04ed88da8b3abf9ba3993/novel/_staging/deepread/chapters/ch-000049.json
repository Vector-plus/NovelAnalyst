      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "c-26",
      "text": "瓦砾重新聚成殿宇，天宫又回到安定与祥和，众神开始各归其位。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 49,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000049.txt",
