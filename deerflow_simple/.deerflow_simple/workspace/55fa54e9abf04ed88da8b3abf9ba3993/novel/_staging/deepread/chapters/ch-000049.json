      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "c-29",
      "text": "观音驾云出天庭，从怀中摸出金蝉子那本手写的经文，抚着若有所思。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0019/index.json",
        "record_id": "char-0019"
      },
      "revealed_at": 49,
      "source_refs": [
