          "chapter_order": 5,
          "locator": null,
          "anchor": "西贺牛洲平天大圣牛魔王"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-11",
      "text": "女子听到“美猴王”之名后现出惊疑神色，反问孙悟空是否认识他。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 5,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000005.txt",
          "chapter_id": "ch-000005",
          "chapter_order": 5,
          "locator": null,
          "anchor": "美……美猴王"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-12",
      "text": "女子喃喃念道“是了，他已记不得一切，也记不得你了”，又扬起脸说“但有一件事你要知道，你就是……”，话未说完。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "林中女子"
      },
      "revealed_at": 5,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000005.txt",
          "chapter_id": "ch-000005",
          "chapter_order": 5,
          "locator": null,
          "anchor": "他已记不得一切，也记不得你了"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-13",
      "text": "女子忽然又一阵剧痛，几乎晕厥过去。",
      "certainty": "explicit",
