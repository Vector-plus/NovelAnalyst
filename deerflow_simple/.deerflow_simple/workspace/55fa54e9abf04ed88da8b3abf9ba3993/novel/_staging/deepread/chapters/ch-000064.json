    },
    {
      "local_id": "claim-local-23",
      "text": "黄袍怪告诉孙悟空\"你师父刚走\"，孙悟空不信，说都在骗他。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0149/index.json",
