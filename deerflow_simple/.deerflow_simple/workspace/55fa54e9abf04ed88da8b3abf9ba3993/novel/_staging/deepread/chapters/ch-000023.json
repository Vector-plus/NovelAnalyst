        },
        {
          "path": "characters/char-0023/index.json",
          "record_id": "char-0023"
        }
      ],
      "record_refs_or_local_ids": [
        "ev-local-1",
        "ev-local-2",
        "claim-local-1",
        "claim-local-2",
        "claim-local-3",
        "claim-local-5",
        "claim-local-9",
