          "chapter_order": 22,
          "locator": null,
          "anchor": "再别找那妖猴了"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-15",
      "text": "紫霞喃喃自问「原来我梦见的……不是花果山？」，随后表示想再待一会儿；二郎神称就带她四处看看。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
