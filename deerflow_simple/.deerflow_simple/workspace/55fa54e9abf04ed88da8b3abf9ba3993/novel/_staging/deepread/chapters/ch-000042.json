      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-2",
      "text": "诸神惊慌躲藏；灵霄殿顶端立着一个身影，发出纵是飓风也盖不过的狂笑声，其巨大阴影随着火焰升高移向整个天庭。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 42,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000042.txt",
