      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-4",
      "text": "金蝉子说突然不想论什么，称永远无法用语言表述一棵树的生长、一朵花的全貌，并问生命真义是什么、要求不要用语言告诉他。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0009/index.json",
        "record_id": "char-0009"
      },
      "revealed_at": 42,
