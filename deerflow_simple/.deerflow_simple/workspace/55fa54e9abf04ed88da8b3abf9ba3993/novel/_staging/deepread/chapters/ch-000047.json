          "chapter_order": 47,
          "locator": {
            "para_start": 39,
            "para_end": 45
          },
          "anchor": "天地生我孙悟空！"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-11",
      "text": "孙悟空这一击落空了——那只是个幻影；落地时他几乎拿不起金箍棒，仍挣扎着站起，反复高喊“如来！出来！与我一战！”。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 47,
      "source_refs": [
