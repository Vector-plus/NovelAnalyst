  "chapter_summary_markdown": {
    "title": "第47章：双猴相杀之后——识破骗局与孙悟空之死",
    "front_matter": {
      "as_of": 47,
      "stage_ref": {
        "path": "navigation/stage-plan.json",
        "record_id": "stage-004"
      },
      "subject_refs_or_candidates": [
