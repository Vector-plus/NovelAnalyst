          "chapter_order": 47,
          "locator": {
            "para_start": 37,
            "para_end": 38
          },
          "anchor": "现在，魔王孙悟空已经不复存在"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-10",
      "text": "孙悟空身体开始粉碎、力量流失，将要消失成为虚无的佛；他不愿忘记一切与所有痛苦、身边之人、路上的足迹，突然跳起来高举金箍棒，喊着自己的名字“天地生我孙悟空！”，使出最后的所有力量冲向天地间至高无上的意志。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 47,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000047.txt",
