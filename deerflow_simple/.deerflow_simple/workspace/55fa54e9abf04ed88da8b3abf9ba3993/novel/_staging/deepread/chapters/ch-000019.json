      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-26",
      "text": "紫霞长叹推测：菩提祖师教了孙悟空法术却不领他悟道，因道不可道、要他自己开悟，又怕他痴迷入歧途，才吩咐他不可说出名字。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0023/index.json",
