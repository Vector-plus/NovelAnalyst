      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-23",
      "text": "紫霞据上述三人推断，孙悟空之师必是菩提祖师。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0023/index.json",
