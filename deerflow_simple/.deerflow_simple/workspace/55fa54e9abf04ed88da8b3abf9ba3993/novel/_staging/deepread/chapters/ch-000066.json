          "locator": null,
          "anchor": "“我心自在佛。”"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-28",
      "text": "皇帝提出：玄奘若西去，便封他为国师、率万乘车马、带黄金宝器、一路抚国纳贡、弘我国威，使诸国知大唐盛名。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "皇帝"
      },
      "revealed_at": 66,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000066.txt",
          "chapter_id": "ch-000066",
          "chapter_order": 66,
          "locator": null,
          "anchor": "我封你为国师"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-29",
      "text": "玄奘说皇帝所说的差事是出使经商、不如派个经营大臣，佛法取不来；并称自己「已在取经的路上」，不愿再被人好心告知答案以致自己不再思索。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0053/index.json",
        "record_id": "char-0053"
      },
      "revealed_at": 66,
