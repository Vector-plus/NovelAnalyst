      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-30",
      "text": "玄奘请求让他自在游于天地，快可百年、迟可千万年以得真义；并说若心中不明了，取回万卷经文也无异白纸几箱，三年五载可取回的经卷换不来可得的无上法。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0053/index.json",
        "record_id": "char-0053"
      },
      "revealed_at": 66,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000066.txt",
          "chapter_id": "ch-000066",
