      "local_id": "claim-local-1",
      "text": "沙僧在深夜一直向前走、不停下（因无人叫他停下），越过深谷、踩倒密林树木、撞穿石壁钻出隧道，在无一点光线的空旷中走向轰鸣声，直到一个声音喝「停」才站住。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 66,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000066.txt",
          "chapter_id": "ch-000066",
          "chapter_order": 66,
          "locator": null,
          "anchor": "沙僧一直向前走，也不停下，因为没有人叫他停下。"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
