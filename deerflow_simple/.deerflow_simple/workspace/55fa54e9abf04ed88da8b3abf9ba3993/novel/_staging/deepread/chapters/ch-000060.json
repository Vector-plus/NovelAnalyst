        "record_id": "char-0001"
      },
      "revealed_at": 60,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000060.txt",
          "chapter_id": "ch-000060",
          "chapter_order": 60,
          "locator": null,
          "anchor": "你们难道不想试一试往北走会发生什么"
