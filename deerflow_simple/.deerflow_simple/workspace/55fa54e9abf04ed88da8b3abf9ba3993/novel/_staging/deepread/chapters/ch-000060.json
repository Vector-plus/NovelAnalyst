          "chapter_id": "ch-000060",
          "chapter_order": 60,
          "locator": null,
          "anchor": "是观音让俺跟着你的"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-3",
      "text": "唐僧说“你不信我你可以走。我没让你跟着我”，并反问徒弟们：这些年一直往西走，难道不想试一试往北走会发生什么。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
