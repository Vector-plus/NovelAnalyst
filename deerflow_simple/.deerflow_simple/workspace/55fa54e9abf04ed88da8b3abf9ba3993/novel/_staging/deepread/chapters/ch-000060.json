    {
      "local_id": "claim-local-1",
      "text": "第五天行进中，孙悟空对唐僧说“师父，你又带错路了”，并指出西在那边；唐僧只回答“没错”，仍往北走。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 60,
      "source_refs": [
        {
          "path": "source/vol-003/ch-000060.txt",
          "chapter_id": "ch-000060",
          "chapter_order": 60,
          "locator": null,
          "anchor": "师父，你又带错路了。"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-2",
      "text": "孙悟空称是观音让他跟着唐僧的，否则他早飞到西天去了；并说要把唐僧送到才能成正果。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
