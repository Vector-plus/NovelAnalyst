      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-9",
      "text": "如来一挥手，云雾散开，露出一片青翠群山。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0057/index.json",
        "record_id": "char-0057"
      },
      "revealed_at": 46,
