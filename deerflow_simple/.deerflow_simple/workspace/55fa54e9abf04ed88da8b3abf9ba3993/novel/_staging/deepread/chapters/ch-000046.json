      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-8",
      "text": "孙悟空觉得眼前这个场景如此熟悉，却想不起来在哪里见过。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0002/index.json",
        "record_id": "char-0002"
      },
      "revealed_at": 46,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000046.txt",
          "chapter_id": "ch-000046",
          "chapter_order": 46,
          "locator": null,
          "anchor": "这个场景如此熟悉，可又想不起来哪里见过"
