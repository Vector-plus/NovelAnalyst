      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-10",
      "text": "如来问那只猴子「你不想回花果山么？」",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0057/index.json",
        "record_id": "char-0057"
      },
      "revealed_at": 46,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000046.txt",
          "chapter_id": "ch-000046",
          "chapter_order": 46,
          "locator": null,
          "anchor": "你不想回花果山么"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-11",
      "text": "那猴子眼望天外、流露憧憬之光，喃喃说「花果山……漫山的花，漫山的果，漫山的朋友……回花果山……回家」。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "没戴金箍的猴子"
      },
      "revealed_at": 46,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000046.txt",
          "chapter_id": "ch-000046",
          "chapter_order": 46,
          "locator": null,
          "anchor": "漫山的花，漫山的果，漫山的朋友"
