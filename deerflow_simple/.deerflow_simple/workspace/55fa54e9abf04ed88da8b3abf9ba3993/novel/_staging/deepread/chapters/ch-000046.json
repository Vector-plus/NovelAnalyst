      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-12",
      "text": "那猴子接着喃喃「可是花果山已经毁了，没有了，没有花果，没有生灵」，随即转头怒视诸神，说「是你们毁了它，毁了他们！我已经什么都没有了！你们也什么都不会有！」",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "没戴金箍的猴子"
      },
      "revealed_at": 46,
      "source_refs": [
