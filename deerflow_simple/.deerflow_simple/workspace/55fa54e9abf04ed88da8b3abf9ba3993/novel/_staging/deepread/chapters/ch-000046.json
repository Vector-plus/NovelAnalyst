      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-2",
      "text": "孙悟空觉出这场战斗的怪异，却始终捕捉不到对手的影子，有时怀疑自己是独自在世界上疯狂地挥舞金箍棒。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0002/index.json",
        "record_id": "char-0002"
      },
      "revealed_at": 46,
