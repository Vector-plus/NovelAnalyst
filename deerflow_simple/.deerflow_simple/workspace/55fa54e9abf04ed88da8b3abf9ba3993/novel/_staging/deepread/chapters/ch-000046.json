      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-13",
      "text": "那猴子大叫一声，冲向诸神。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": {
        "candidate_name": "没戴金箍的猴子"
