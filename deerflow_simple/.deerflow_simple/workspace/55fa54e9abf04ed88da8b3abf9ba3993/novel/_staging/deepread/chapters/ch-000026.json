    },
    {
      "local_id": "claim-local-11",
      "text": "王母爆发，骂孙悟空“你……这个妖猴！”。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0022/index.json",
        "record_id": "char-0022"
      },
      "revealed_at": 26,
      "source_refs": [
