    {
      "local_id": "claim-local-12",
      "text": "孙悟空说“多谢，我就是那只妖猴”，并声明自己的名字叫孙悟空，还说“从今往后一万年，你们都会记住我的名字！”。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0002/index.json",
        "record_id": "char-0002"
      },
      "revealed_at": 26,
      "source_refs": [
