      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-8",
      "text": "王母笑着对阿瑶说“阿瑶，你坐啊，你为什么不坐呢？”",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0022/index.json",
        "record_id": "char-0022"
      },
      "revealed_at": 26,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000026.txt",
          "chapter_id": "ch-000026",
          "chapter_order": 26,
          "locator": null,
          "anchor": "你为什么不坐呢？"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-9",
      "text": "孙悟空左右张望，问“哪儿来的鸟叫唤？”，又称“那边那个会变色的东西……好像个大白薯”，讥指王母。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0002/index.json",
        "record_id": "char-0002"
      },
      "revealed_at": 26,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000026.txt",
          "chapter_id": "ch-000026",
          "chapter_order": 26,
          "locator": null,
          "anchor": "哪儿来的鸟叫唤？"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-10",
      "text": "阿瑶忍不住笑出声，说“变色大白薯，哈哈哈哈，变色大白薯，王母娘娘是变色大白薯”；她笑到滚倒地上、用手捶地、眼泪哗哗流下，最后把头埋在地上呜咽不停。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 26,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000026.txt",
          "chapter_id": "ch-000026",
