          "locator": null,
          "anchor": "只见王母的宝座飞了起来"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-7",
      "text": "孙悟空把飞来的宝座移到阿瑶面前让给她坐，说“让给受伤小姑娘坐才对啊”；阿瑶脸都白了，像怕那椅子会吃人一样不坐。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 26,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000026.txt",
          "chapter_id": "ch-000026",
          "chapter_order": 26,
          "locator": null,
          "anchor": "让给受伤小姑娘坐才对啊"
