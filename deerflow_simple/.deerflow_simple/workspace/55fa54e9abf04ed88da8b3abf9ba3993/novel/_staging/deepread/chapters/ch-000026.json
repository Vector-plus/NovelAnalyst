  "new_claims": [
    {
      "local_id": "claim-local-1",
      "text": "天宫大殿中传来嗡嗡声，巨灵神问“哪儿来的苍蝇”，坐在他旁边的广目天王忙把一个桃子塞入他嘴里；那声音实为王母气得浑身打抖发出。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 26,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000026.txt",
          "chapter_id": "ch-000026",
          "chapter_order": 26,
          "locator": null,
          "anchor": "那声音却是王母发出来的"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-2",
      "text": "大殿门刚关上又被砰的一声撞开，进来的却是阿瑶，她身后走出孙悟空。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 26,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000026.txt",
          "chapter_id": "ch-000026",
          "chapter_order": 26,
          "locator": null,
          "anchor": "这回进来的，却是阿瑶。"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-3",
      "text": "孙悟空当众说“桃子是俺老孙吃了，怎么了？不行？”，并要求给他搬个椅子来。",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0002/index.json",
        "record_id": "char-0002"
      },
      "revealed_at": 26,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000026.txt",
          "chapter_id": "ch-000026",
          "chapter_order": 26,
          "locator": null,
          "anchor": "桃子是俺老孙吃了"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-4",
      "text": "王母说“搬给他”，一个小矮凳被搬了上来，摆在大殿的一角；孙悟空一脚把凳子踢飞。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 26,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000026.txt",
          "chapter_id": "ch-000026",
          "chapter_order": 26,
          "locator": null,
          "anchor": "一个小矮凳被搬了上来"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-5",
      "text": "王母喝问孙悟空“你想造反么？”",
      "certainty": "reported",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0022/index.json",
        "record_id": "char-0022"
      },
      "revealed_at": 26,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000026.txt",
          "chapter_id": "ch-000026",
          "chapter_order": 26,
          "locator": null,
          "anchor": "你想造反么？"
        }
      ],
      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-6",
      "text": "孙悟空一扬手，王母的宝座飞了起来，将王母掀个大跟头，越过众神飞到孙悟空面前。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 26,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000026.txt",
          "chapter_id": "ch-000026",
