    {
      "local_id": "claim-local-10",
      "text": "人界万灵之森中，大雪把唐僧的墓覆盖成一个白丘，与白茫茫的大地融成一体。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 38,
      "source_refs": [
        {
          "path": "source/vol-001/ch-000038.txt",
