      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-8",
      "text": "孙悟空在激战中想起观音那句话，决意不能输，大吼「我就不信打不中你！」，把棒舞得更快更急。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": {
        "path": "characters/char-0002/index.json",
        "record_id": "char-0002"
