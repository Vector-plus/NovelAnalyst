      "basis_refs": [],
      "supersedes_refs": []
    },
    {
      "local_id": "claim-local-9",
      "text": "旁观的天神只听见风雪中兵器相击声越来越密，最后连成一片刺耳的嚣鸣。",
      "certainty": "explicit",
      "attributed_to_candidate_or_ref": null,
      "revealed_at": 38,
      "source_refs": [
