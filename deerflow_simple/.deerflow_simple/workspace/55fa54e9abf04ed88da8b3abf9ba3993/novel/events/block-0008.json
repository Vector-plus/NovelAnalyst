              "basis_refs": [],
              "supersedes_refs": []
            },
            {
              "id": "claim-2559",
              "text": "孙悟空一回头，满天云雾疾扑而来，仿佛时光千万里离他而去、身在九天之外，云雾散开后面前出现一尊巨佛。",
              "certainty": "explicit",
              "attributed_to_ref": null,
