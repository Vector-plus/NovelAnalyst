              "basis_refs": [],
              "supersedes_refs": []
            },
            {
              "id": "claim-2560",
              "text": "巨佛的宏大而平缓的声音说：“孙悟空，你说跳出我掌心，便把天宫让你，现在你跳来跳去，跳出去了么？”又说“若跳不出时，你便老实下界，再修几劫，却来争吵”。",
              "certainty": "reported",
              "attributed_to_ref": {
                "path": "characters/char-0169/index.json",
                "record_id": "char-0169"
              },
              "revealed_at": 68,
              "source_refs": [
                {
                  "path": "source/vol-003/ch-000068.txt",
                  "chapter_id": "ch-000068",
                  "chapter_order": 68,
                  "locator": null,
                  "anchor": "你说跳出我掌心，便把天宫让你"
