                  "anchor": "竟格外的忍耐",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "道玄真人闻言脸色一变似有怒容，但面对老人格外忍耐，随即忍住了。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0007/index.json",
                "record_id": "char-0007"
              },
              "basis_refs": [],
              "certainty": "reported",
              "id": "claim-5338",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "前来青云山拜山了",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "道玄真人告知老人：就在今日迟些时候，焚香谷谷主云易岚将率门下弟子前来青云山拜山。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0265/index.json",
                "record_id": "char-0265"
              },
              "basis_refs": [],
              "certainty": "reported",
              "id": "claim-5339",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "可是个老滑头了",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "老人冷笑称云易岚「可是个老滑头了」。"
            }
          ],
