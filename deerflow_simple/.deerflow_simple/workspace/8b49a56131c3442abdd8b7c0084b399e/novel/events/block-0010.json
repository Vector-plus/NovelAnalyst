                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "林惊羽持斩龙剑凌空扑下，施展「斩鬼神」剑诀，一击深深刺入地底，将法阵内地面轰出巨大深坑。"
            },
            {
              "attributed_to_ref": null,
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5310",
              "revealed_at": 144,
              "source_refs": [
