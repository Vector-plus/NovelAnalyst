          ],
          "claims": [
            {
              "attributed_to_ref": null,
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5340",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "到处都是各种怪异的妖兽异族",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "南疆七里峒山脉的森林已失去原貌，阴风呼啸、黑云低垂，到处是怪异妖兽与被杀戮的鸟兽尸体。"
            },
            {
              "attributed_to_ref": null,
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5341",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "领头的就是这一只状极可怖的妖物白骨妖蛇",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "七里峒苗人聚居地被无数妖兽团团包围，领头的是白骨妖蛇；其身躯巨大，所过之处白骨挥舞，并能喷出毒气中人即死。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0153/index.json",
                "record_id": "char-0153"
              },
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5342",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "让苗族族长图麻骨将残余苗人撤入祭坛",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "青龙让苗族族长图麻骨将残余苗人撤入祭坛，祭坛中的巫师以略懂的南疆巫法抵抗一阵。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0153/index.json",
                "record_id": "char-0153"
              },
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5343",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "将大部分妖物的注意力引到自己身上",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "青龙偷袭白骨妖蛇，并以迅疾身法连下重手杀伤妖兽，将大部分妖物的注意力引到自己身上。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0153/index.json",
                "record_id": "char-0153"
              },
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5344",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "他名列鬼王宗四大圣使之首",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "青龙名列鬼王宗四大圣使之首。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0153/index.json",
                "record_id": "char-0153"
              },
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5345",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "乾坤清光戒",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "青龙身怀奇宝「乾坤清光戒」，以他的道行仍无法胜过白骨妖蛇。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0264/index.json",
                "record_id": "char-0264"
              },
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5346",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "忽地三对翅膀震动",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "白骨妖蛇生有三对翅膀，震动后巨大身躯飞起，凌空扑向青龙。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0153/index.json",
                "record_id": "char-0153"
              },
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5347",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "朝与七里峒相反方向飞去",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "青龙从白骨妖蛇身躯扭动的缝隙间穿过，朝与七里峒相反的方向飞去，渐渐将妖物甩远。"
            }
          ],
