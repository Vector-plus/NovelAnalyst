                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "道玄真人问老人「刚才都看到了」，并说自己没有想到老人会将「斩鬼神」传给了林惊羽。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0265/index.json",
                "record_id": "char-0265"
              },
              "basis_refs": [],
              "certainty": "reported",
              "id": "claim-5336",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "难道都如你一般藏密于身",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "老人反问「为何不传」，讥讽道玄藏密于身、要带到棺材里去。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0007/index.json",
                "record_id": "char-0007"
              },
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5337",
              "revealed_at": 144,
              "source_refs": [
