    {
      "id": "ev-0748",
      "introduced_at": 144,
      "kind": "event",
      "safe_through": 144,
      "title": "道玄真人上香并告知焚香谷将来拜山",
      "updates": [
        {
          "action_refs": [
            {
              "path": "events/block-0010.json",
              "record_id": "claim-5330"
            },
            {
              "path": "events/block-0010.json",
              "record_id": "claim-5338"
            }
          ],
          "chapter_ranges": [
            {
              "end": 144,
              "start": 144
            }
          ],
          "claims": [
            {
              "attributed_to_ref": {
                "path": "characters/char-0007/index.json",
                "record_id": "char-0007"
              },
              "basis_refs": [],
              "certainty": "explicit",
              "id": "claim-5330",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "拿起三根细香",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "道玄真人已在祖师祠堂大殿灵位前，取三根细香点燃、恭敬三鞠躬后插入香炉。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0007/index.json",
                "record_id": "char-0007"
              },
              "basis_refs": [],
              "certainty": "reported",
              "id": "claim-5331",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "我有段日子没来进香了",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "道玄真人说「我有段日子没来进香了」，不知列位祖师会不会怪罪。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0265/index.json",
                "record_id": "char-0265"
              },
              "basis_refs": [],
              "certainty": "reported",
              "id": "claim-5332",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "又怎么会怪罪你",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "老人答道玄将青云门搞得有声有色，列位祖师欢喜还来不及，不会怪罪他。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0007/index.json",
                "record_id": "char-0007"
              },
              "basis_refs": [],
              "certainty": "reported",
              "id": "claim-5333",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "好像又老了几分了",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "道玄真人对老人说「你好像又老了几分了」。"
            },
            {
              "attributed_to_ref": {
                "path": "characters/char-0265/index.json",
                "record_id": "char-0265"
              },
              "basis_refs": [],
              "certainty": "reported",
              "id": "claim-5334",
              "revealed_at": 144,
              "source_refs": [
                {
                  "anchor": "连心都死了的人，自然老的比较快",
                  "chapter_id": "ch-000144",
                  "chapter_order": 144,
                  "path": "source/vol-004/ch-000144.txt"
                }
              ],
              "supersedes_refs": [],
              "text": "老人回答「连心都死了的人，自然老的比较快」。"
            },
            {
              "attributed_to_ref": {
